    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "^2.9.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "iron-session": "^9.0.1",
