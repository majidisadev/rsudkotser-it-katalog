# === Katalog IT Kota Serang — contoh environment (SDD Config) ===
# Salin ke .env dan sesuaikan. Jangan commit .env.

# Database (Neon atau Postgres self-host — sama-sama Postgres wire).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/katalog

# Storage media bukti: "local" (self-host) | "vercel-blob" (Vercel).
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./.storage
# BLOB_READ_WRITE_TOKEN=   # wajib bila STORAGE_DRIVER=vercel-blob

# Rate limiting: kosongkan Upstash → pakai limiter in-memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60

# Auth admin (dipakai penuh Sprint 03). Hash argon2id, bukan plaintext.
# Buat hash: node -e "require('@node-rs/argon2').hash('PASSWORD').then(console.log)"
# PENTING (berkas .env): dotenv-expand Next menafsirkan `$` sebagai variabel →
#   escape tiap `$` menjadi `\$`. Contoh: \$argon2id\$v=19\$m=...\$...
#   (Di Vercel / env langsung, pakai hash apa adanya tanpa escape.)
ADMIN_PASSWORD_HASH=\$argon2id\$ganti-dengan-hash-asli
SESSION_SECRET=ganti-dengan-rahasia-min-32-karakter-untuk-iron-session

APP_URL=http://localhost:3000
